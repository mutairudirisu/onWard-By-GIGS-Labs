# onWard PWA → Supabase project "onWard" (ref lakpaqruemdjyvwprfme)
# The key below is the publishable (anon) key: safe in client code because every
# table is protected by row level security. Never put the service role key here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-anon-key>

# Server-only OpenAI key for the Exchange Proofread feature. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Web Push. Generate with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:replace-with-a-monitored-address@example.com

# Server-only Supabase and Vercel Cron secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
